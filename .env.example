# Runtime/serverless connection (Supabase Transaction pooler, port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1"

# Prisma migrations (Supabase Session pooler/direct connection, port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Required only while seeding an external database; do not expose publicly
SEED_ADMIN_PASSWORD=""
SEED_USER_PASSWORD=""

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google Gemini AI
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"

# Stripe Test Mode — valorile reale rămân numai în .env local/hosting
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
